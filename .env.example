# Postgres connection string used by the app.
# NOTE: docker-compose overrides this with postgres://retro:${POSTGRES_PASSWORD}@db:5432/retro
DATABASE_URL=postgres://retro:change-me@localhost:5432/retro
# Password for the Postgres container (docker-compose); keep consistent with DATABASE_URL
POSTGRES_PASSWORD=change-me
# HTTP port the server listens on (default 3000)
PORT=3000
# Set true when running behind Fly.io/Railway/Caddy so rate limits see real client IPs (default false)
TRUST_PROXY=false
# Public URL of this app (used for links and OAuth redirect), no trailing slash
PUBLIC_BASE_URL=http://localhost:3000
# Secret required to create boards (>= 16 chars). Generate: openssl rand -base64 32
OWNER_SECRET=
# Comma-separated invite codes that allow joining/creating. Example: alpha,beta
INVITE_CODES=
# Cookie/session signing secret (>= 32 chars). Generate: openssl rand -base64 32
SESSION_SECRET=
# AES-256-GCM key for Atlassian tokens: base64 of exactly 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Optional: Atlassian OAuth app credentials; leave both blank to disable Confluence export
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
